# Prefer the hosting platform's secret manager. This file is an optional local fallback.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Required explicit comma-separated HTTPS origins, without paths or wildcards.
WEB_ORIGIN=
# Required: runtime role only. Never put migration/admin credentials here.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_SSL_CA_FILE=
