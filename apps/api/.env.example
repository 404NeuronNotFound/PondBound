NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Runtime role only: pondbound_api (or pondbound_api.PROJECT_REF via Supavisor).
# Copy the host from Supabase Connect. Never use postgres or migrator credentials here.
DATABASE_URL=
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
# Optional provider CA certificate path. TLS verification is always enabled remotely.
DB_SSL_CA_FILE=
# Public project configuration for server-side access-token verification.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
