{
  "name": "@pondbound/api", "private": true, "version": "0.1.0", "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pondbound/shared build && pnpm db:generate && tsc-watch --onSuccess \"node dist/main.js\"",
    "dev:watch": "pnpm db:generate && tsc-watch --onSuccess \"node dist/main.js\"",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "db:generate": "prisma generate", "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev", "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1", "@nestjs/core": "^12.0.1", "@nestjs/platform-express": "^12.0.1",
    "@pondbound/shared": "workspace:*", "@prisma/adapter-pg": "7.10.0", "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1", "class-validator": "^0.15.1", "dotenv": "^18.0.6",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.1", "zod": "^4.6.6"
  },
  "devDependencies": { "@pondbound/typescript-config": "workspace:*", "@types/node": "^24.13.3", "prisma": "7.10.0", "tsc-watch": "^7.2.0", "typescript": "~6.0.2" }
}
