{
  "name": "@pondbound/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pondbound/shared build && pnpm db:generate && tsc-watch --onSuccess \"node dist/main.js\"",
    "dev:watch": "pnpm db:generate && tsc-watch --onSuccess \"node dist/main.js\"",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "start": "node scripts/start-runtime.mjs production",
    "start:prod": "node scripts/start-runtime.mjs production",
    "start:test": "node scripts/start-runtime.mjs test",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "pnpm build && node --import ./scripts/test-environment.mjs --test test/*.test.mjs",
    "test:unit": "pnpm build && node --import ./scripts/test-environment.mjs --test test/*.unit.test.mjs",
    "test:integration": "pnpm build && node --import ./scripts/test-environment.mjs --test test/*.http.test.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:bootstrap": "node scripts/bootstrap-database.mjs",
    "db:verify": "node scripts/verify-database.mjs",
    "storage:provision": "node scripts/provision-storage.mjs",
    "auth:verify": "node scripts/verify-auth.mjs",
    "test:database": "pnpm build && node --import ./scripts/test-environment.mjs --test test/database.integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@pondbound/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.1",
    "@supabase/supabase-js": "^2.117.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@pondbound/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "prisma": "7.10.0",
    "tsc-watch": "^7.2.0",
    "typescript": "~6.0.2"
  }
}
