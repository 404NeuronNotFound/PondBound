# Loaded only by the explicit test server, never from the development .env.
NODE_ENV=test
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional disposable test connections; ordinary unit/HTTP tests inject their own fakes.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DB_POOL_MAX=2
DB_CONNECTION_TIMEOUT_MS=1000
DB_QUERY_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=1000
DB_SSL_CA_FILE=
