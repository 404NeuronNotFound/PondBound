{
  "name": "@pondbound/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pondbound/shared build && pnpm --filter @pondbound/game-config build && vite --host 127.0.0.1",
    "dev:watch": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "build:test": "tsc --noEmit && vite build --mode test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pondbound/shared": "workspace:*",
    "@pondbound/game-config": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "dotenv": "^18.0.6",
    "@pondbound/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "jsdom": "^30.1.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/jest-dom": "^7.0.1"
  }
}
