{
  "name": "pondbound",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "env:setup": "node scripts/setup.mjs",
    "dev": "pnpm --filter @pondbound/shared --filter @pondbound/game-config build && pnpm --parallel --filter @pondbound/web --filter @pondbound/api dev:watch",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @pondbound/shared --filter @pondbound/game-config build && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @pondbound/shared --filter @pondbound/game-config build && pnpm --filter @pondbound/web --filter @pondbound/api test",
    "test:unit": "pnpm --filter @pondbound/shared --filter @pondbound/game-config build && pnpm --filter @pondbound/web test && pnpm --filter @pondbound/api test:unit",
    "test:integration": "pnpm --filter @pondbound/shared build && pnpm --filter @pondbound/api test:integration",
    "test:database": "pnpm --filter @pondbound/api test:database",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:secrets",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:generate": "pnpm --filter @pondbound/api db:generate",
    "db:validate": "pnpm --filter @pondbound/api db:validate",
    "db:migrate": "pnpm --filter @pondbound/api db:migrate",
    "db:deploy": "pnpm --filter @pondbound/api db:deploy",
    "db:status": "pnpm --filter @pondbound/api db:status",
    "db:seed": "pnpm --filter @pondbound/api db:seed",
    "db:bootstrap": "pnpm --filter @pondbound/api db:bootstrap",
    "db:verify": "pnpm --filter @pondbound/api db:verify",
    "storage:provision": "pnpm --filter @pondbound/api storage:provision",
    "auth:verify": "pnpm --filter @pondbound/api auth:verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "typescript-eslint": "^8.69.0",
    "typescript": "~6.0.2"
  }
}
